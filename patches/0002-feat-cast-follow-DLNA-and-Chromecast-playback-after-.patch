+data class EchoLanCastPlayback(
+    val rendererName: String,
+    val index: Int,
+    val track: EchoLinkCastSourceTrack,
+    val isPlaying: Boolean,
+    val durationMs: Long,
+    /** 0..1；设备不支持读取音量时为 null。 */
