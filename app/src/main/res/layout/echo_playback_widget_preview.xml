<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/echo_widget_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"
        android:padding="12dp"
        android:tint="@color/playback_widget_secondary"
        android:src="@drawable/media3_notification_small_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/playback_widget_preview_title"
            android:textColor="@color/playback_widget_foreground"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/playback_widget_idle"
            android:textColor="@color/playback_widget_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="4dp"
                android:background="@drawable/echo_widget_tonal_surface"
                android:padding="11dp"
                android:contentDescription="@string/playback_widget_previous"
                android:tint="@color/playback_widget_on_tonal"
                android:src="@drawable/echo_ic_skip_previous" />

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/echo_widget_play_surface"
                android:padding="10dp"
                android:contentDescription="@string/playback_widget_play"
                android:tint="@color/playback_widget_on_accent"
                android:src="@drawable/echo_ic_play" />

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="4dp"
                android:background="@drawable/echo_widget_tonal_surface"
                android:padding="11dp"
                android:contentDescription="@string/playback_widget_next"
                android:tint="@color/playback_widget_on_tonal"
                android:src="@drawable/echo_ic_skip_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
