<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/echo_widget_surface" android:clipToOutline="true" android:orientation="vertical">
    <ImageView
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:contentDescription="@null" android:scaleType="centerCrop" android:src="@drawable/echo_widget_preview_artwork" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:includeFontPadding="false"
            android:text="@string/playback_widget_preview_title"
            android:textColor="@color/playback_widget_foreground" android:textSize="20sp" android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1"
            android:text="@string/playback_widget_idle" android:textColor="@color/playback_widget_secondary" android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="12dp" android:gravity="end|center_vertical" android:orientation="horizontal">
            <ImageView
                android:layout_width="48dp" android:layout_height="48dp" android:padding="11dp"
                android:contentDescription="@string/playback_widget_previous"
                android:tint="@color/playback_widget_foreground" android:src="@drawable/echo_widget_ic_previous" />
            <ImageView
                android:layout_width="48dp" android:layout_height="48dp" android:layout_marginHorizontal="12dp"
                android:padding="8dp"
                android:contentDescription="@string/playback_widget_play"
                android:tint="@color/playback_widget_foreground" android:src="@drawable/echo_widget_ic_play" />
            <ImageView
                android:layout_width="48dp" android:layout_height="48dp" android:padding="11dp"
                android:contentDescription="@string/playback_widget_next"
                android:tint="@color/playback_widget_foreground" android:src="@drawable/echo_widget_ic_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
