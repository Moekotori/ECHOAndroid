<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/echo_widget_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">
    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null"
        android:padding="6dp"
        android:tint="@color/playback_widget_secondary"
        android:src="@drawable/media3_notification_small_icon" />
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/playback_widget_preview_title"
        android:textColor="@color/playback_widget_foreground"
        android:textStyle="bold"
        android:textSize="14sp" />
    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:background="@drawable/echo_widget_play_surface"
        android:contentDescription="@string/playback_widget_play"
        android:tint="@color/playback_widget_background"
        android:src="@drawable/echo_ic_play" />
</LinearLayout>
