<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:background="@drawable/echo_widget_surface" android:clipToOutline="true">
    <ImageView android:layout_width="120dp" android:layout_height="match_parent" android:scaleType="centerCrop"
        android:contentDescription="@null" android:src="@drawable/echo_widget_preview_artwork" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:padding="12dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:text="@string/playback_widget_preview_title" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/playback_widget_foreground" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:text="@string/playback_widget_idle" android:textSize="12sp" android:textColor="@color/playback_widget_secondary" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="end|center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="9dp"
                android:contentDescription="@string/playback_widget_previous" android:src="@drawable/echo_widget_ic_previous" android:tint="@color/playback_widget_foreground" />
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="6dp" android:layout_marginHorizontal="2dp"
                android:contentDescription="@string/playback_widget_play" android:src="@drawable/echo_widget_ic_play" android:tint="@color/playback_widget_foreground" />
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="9dp"
                android:contentDescription="@string/playback_widget_next" android:src="@drawable/echo_widget_ic_next" android:tint="@color/playback_widget_foreground" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
