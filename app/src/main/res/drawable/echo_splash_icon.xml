<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingMode="stack">
    <!-- Scale every layer with the system icon bounds; a fixed dp layer is clipped by its mask. -->
    <item android:drawable="@drawable/echo_splash_ground" />
    <item>
        <inset
            android:insetLeft="22.2222%"
            android:insetRight="22.2222%"
            android:insetTop="22.2222%"
            android:insetBottom="22.2222%">
            <bitmap
                android:src="@drawable/echo_startup_still"
                android:gravity="fill"
                android:filter="true" />
        </inset>
    </item>
</layer-list>
