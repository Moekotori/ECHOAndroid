<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingMode="stack">
    <!-- Keep ECHO's mascot as the focal point, inside the system splash safe area. -->
    <item android:drawable="@drawable/echo_splash_ground" />
    <item android:width="288dp" android:height="288dp" android:gravity="center">
        <inset
            android:insetLeft="22.2222%"
            android:insetRight="22.2222%"
            android:insetTop="22.2222%"
            android:insetBottom="22.2222%">
            <bitmap
                android:src="@drawable/echo_startup_still"
                android:gravity="fill"
                android:filter="true" />
        </inset>
    </item>
</layer-list>
