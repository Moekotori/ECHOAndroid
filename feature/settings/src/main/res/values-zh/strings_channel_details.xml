    <string name="channel_stereo_hint">保留独立的左右输出，维持立体声声场。</string>
    <string name="channel_sum_hint">将调整后的左右信号取平均，再同时送往两侧输出。</string>
    <string name="channel_left_only_hint">保留调整后的左侧输出，右侧静音。</string>
    <string name="channel_right_only_hint">保留调整后的右侧输出，左侧静音。</string>
    <string name="channel_advanced_title">进阶校准</string>
