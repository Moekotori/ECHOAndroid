<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="usb_passthrough_warning_title">小心音量突然变大</string>
    <string name="usb_passthrough_warning_body">整数直通会将数字音量固定为 100%，绕过应用音量和 DSP 处理，声音可能突然变得很大。请先调低 DAC 或耳放的硬件音量。若设备没有硬件音量控制，请取消并保持处理模式。</string>
    <string name="usb_passthrough_warning_wait">请先检查音量（%1$d 秒）</string>
    <string name="usb_passthrough_warning_confirm">已调低硬件音量，开启</string>
</resources>
