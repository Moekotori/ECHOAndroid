<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="settings_lyrics_interface">歌词界面</string>
    <string name="settings_lyrics_interface_detail">打开歌词页，在页内设置样式、字体和对齐。</string>
    <string name="settings_lyrics_source_order">歌词获取顺序</string>
    <string name="settings_lyrics_source_order_detail">按顺序尝试本地来源；手动选定始终优先，缺失或解析失败则尝试下一项。在线匹配仍由独立开关控制。</string>
    <string name="settings_lyrics_source_spl">SPL</string>
    <string name="settings_lyrics_source_sidecar">LRC / 其他同名歌词文件</string>
    <string name="settings_lyrics_source_embedded">内嵌歌词</string>
    <string name="settings_lyrics_source_up">上移</string>
    <string name="settings_lyrics_source_down">下移</string>
    <string name="settings_lyrics_apply">完成</string>
    <string name="settings_lyrics_cancel">取消</string>
    <string name="settings_notification_lyrics">通知栏歌词</string>
    <string name="settings_notification_lyrics_detail">在媒体通知中显示当前歌词；部分 Android 版本会使用系统媒体元数据显示。</string>
    <string name="settings_status_overlay_lyrics">悬浮窗状态栏歌词</string>
    <string name="settings_status_overlay_lyrics_detail">在屏幕顶部显示可点击穿透的迷你歌词，需要悬浮窗权限。系统状态栏可能遮住窗口，可将位置调整到状态栏下方。</string>
    <string name="settings_status_lyrics_layout">状态栏歌词位置与大小</string>
    <string name="settings_status_lyrics_layout_detail">调整宽度、字号和位置，避开时间、摄像头与系统图标。</string>
    <string name="settings_system_status_lyrics">系统级状态栏歌词</string>
    <string name="settings_system_status_lyrics_detail">Flyme 实验性兼容，默认关闭。需要系统支持；如媒体通知显示异常，请关闭。</string>
    <string name="settings_system_status_lyrics_unsupported">目前原生状态栏歌词适配魅族 Flyme，此设备可使用悬浮窗状态栏歌词。</string>
    <string name="settings_status_lyrics_hide_translation">状态栏歌词不显示翻译</string>
    <string name="settings_status_lyrics_hide_translation_detail">同时作用于两种状态栏模式；使用已解析的翻译，包括同时间戳的翻译行。</string>
    <string name="settings_status_lyrics_preview">下一句，继续唱</string>
    <string name="settings_status_lyrics_font">字号</string>
    <string name="settings_status_lyrics_width">窗口宽度</string>
    <string name="settings_status_lyrics_x">距左边缘</string>
    <string name="settings_status_lyrics_y">距状态栏下缘</string>
    <string name="settings_status_lyrics_reset">重置状态栏歌词布局</string>
</resources>
