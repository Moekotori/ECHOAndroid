    <string name="onboarding_skip">跳过</string>
    <string name="onboarding_step">初次见面 · %1$d / %2$d</string>
    <string name="onboarding_back">上一步</string>
    <string name="onboarding_next">下一步</string>
    <string name="onboarding_saving">正在保存…</string>
    <string name="onboarding_save_failed">未能保存，请再试一次。</string>

    <string name="onboarding_music_title">欢迎来到 ECHO</string>
    <string name="onboarding_music_body">你的音乐，由你做主。手机里的歌、NAS 里的曲库，都放在这里听。</string>
    <string name="onboarding_import_title">添加本地音乐</string>
    <string name="onboarding_import_body">扫描设备或选择音乐文件夹，需要访问时再请求授权。</string>
    <string name="onboarding_sources_title">也能连接其他曲库</string>
    <string name="onboarding_sources_body">在曲库页添加 Subsonic、WebDAV、SMB 共享，或 Jellyfin / Emby。</string>

    <string name="onboarding_player_title">听歌，也看见音乐</string>
    <string name="onboarding_player_body">浏览曲库时，正在播放的歌曲始终在手边。</string>
    <string name="onboarding_open_player_title">打开播放器</string>
    <string name="onboarding_open_player_body">点击底部播放条，查看封面、播放控制和队列。</string>
    <string name="onboarding_lyrics_title">跟着歌词听</string>
    <string name="onboarding_lyrics_body">支持本地歌词和逐字高亮；在线歌词可在设置中开启。</string>
    <string name="onboarding_sound_title">调成你喜欢的声音</string>
    <string name="onboarding_sound_body">均衡器、耳机校正，以及 USB 外置设备输出，具体支持取决于设备与音源。</string>
    <string name="onboarding_lyrics_preview">让歌词陪着音乐</string>
    <string name="onboarding_player_preview">封面 · 歌词 · 队列</string>

    <string name="onboarding_pc_title">把 ECHO 搬到电脑上</string>
    <string name="onboarding_pc_body">PC 版 ECHO 已在 Steam 上架。电脑接音箱或 DAC，手机负责选歌和控制。</string>
    <string name="onboarding_steam_tag">ECHO · PC · STEAM</string>
    <string name="onboarding_steam_headline">手机 + 电脑，共用同一份音乐体验</string>
    <string name="onboarding_steam_body">用 Echo Link 配对后，手机就是 PC 版 ECHO 的随身遥控器。</string>
    <string name="onboarding_steam_button">在 Steam 查看 ECHO</string>
    <string name="onboarding_steam_browse">在手机上浏览电脑曲库，局域网串流到手机收听</string>
    <string name="onboarding_steam_remote">播放、暂停、切歌、调音量，都能在手机上遥控电脑</string>
    <string name="onboarding_steam_cast">把手机正在听的歌投送到电脑播放（需双方版本支持）</string>
    <string name="onboarding_steam_note">Android 版完全可以独立使用，不买 PC 版也不影响。联动时，手机和电脑需在同一局域网。购买 Steam 版也是对后续开发的支持。</string>
    <string name="onboarding_link_error">无法在此设备上打开链接。</string>

    <string name="onboarding_manners_title">最后，说句心里话</string>
    <string name="onboarding_manners_quote">提问请讲文明、懂礼貌。\n世界上没有人欠你的。</string>
    <string name="onboarding_manners_quote_body">回答你的人是在用自己的时间帮你，请把这份帮助当作情分，而不是义务。</string>
    <string name="onboarding_do_title">这样问，更容易得到帮助</string>
    <string name="onboarding_do_1">先问好，说清楚遇到了什么，事后说声谢谢</string>
    <string name="onboarding_do_2">附上手机型号、系统版本、ECHO 版本、复现步骤，最好有截图或日志</string>
    <string name="onboarding_do_3">先看过 README、文档和已有的 Issues</string>
    <string name="onboarding_dont_title">请不要</string>
    <string name="onboarding_dont_1">辱骂、阴阳怪气、人身攻击</string>
    <string name="onboarding_dont_2">催促、指责，或要求“立刻解决”</string>
    <string name="onboarding_dont_3">只发一句“不能用”就等答案</string>
    <string name="onboarding_sample_label">好的提问长这样</string>
    <string name="onboarding_sample_text">你好！Pixel 8 / Android 15 / ECHO 1.x，扫描 SD 卡后专辑封面不显示。步骤：…… 附截图，谢谢！</string>
    <string name="onboarding_feedback_title">反馈渠道</string>
    <string name="onboarding_feedback_link">打开 GitHub Issues</string>
    <string name="onboarding_accept_add">我明白了，添加音乐</string>
    <string name="onboarding_accept_explore">我明白了，先逛逛</string>
</resources>
